#!/bin/sh
#
# Snap command-chain wrapper for Semaphore.
#
# Reads the snap configuration options (managed via `snap set semaphore ...`)
# and exports them as SEMAPHORE_* environment variables before launching the
# actual command. Semaphore is started with `--no-config`, so its whole
# configuration comes from these variables instead of a config.json file.
#
# Options are namespaced per app:
#   server.*  — used by the `server` daemon and the `cli` app
#   runner.*  — used by the `runner` daemon
#
# This script is referenced from `command-chain` in snapcraft.yaml and must
# end by exec-ing "$@" so the real app command keeps running as the same
# process (important for the systemd-managed daemons).
set -eu

# Export ENV_NAME=<value of snap option SNAP_KEY>, but only when the option is
# set to a non-empty value. Skipping empty values lets Semaphore apply its own
# built-in defaults and avoids feeding empty strings to typed (e.g. integer)
# config fields.
export_opt() {
    _env_name="$1"
    _snap_key="$2"
    _value="$(snapctl get "$_snap_key" 2>/dev/null || true)"
    if [ -n "$_value" ]; then
        export "$_env_name=$_value"
    fi
}

# Export ENV_NAME=<value of snap option SNAP_KEY>, generating and persisting a
# random secret on first use. The value is stored back into the snap options
# so it stays stable across restarts: cookie secrets keep sessions valid and
# access_key_encryption must never change once data is encrypted with it.
export_secret() {
    _env_name="$1"
    _snap_key="$2"
    _value="$(snapctl get "$_snap_key" 2>/dev/null || true)"
    if [ -z "$_value" ]; then
        _value="$(tr -dc A-Za-z0-9 </dev/urandom | head -c 32)"
        # snapctl set needs root; for non-root CLI runs fall back to a
        # one-off value instead of failing (the daemon runs as root and
        # will persist real secrets on its first start).
        snapctl set "$_snap_key=$_value" 2>/dev/null || true
    fi
    export "$_env_name=$_value"
}

# --- Detect which app is being launched ------------------------------------
# command-chain receives the full command, e.g.:
#   bin/semaphore server --no-config              -> server
#   bin/semaphore runner start ... --no-config    -> runner
#   bin/semaphore --no-config <user args>         -> cli (uses server config)
mode=server
for arg in "$@"; do
    case "$arg" in
        runner) mode=runner; break ;;
        server) break ;;
    esac
done

# --- Common ------------------------------------------------------------------
export SEMAPHORE_TMP_PATH="${SNAP_COMMON}/repositories"
export SEMAPHORE_GIT_CLIENT="go_git"
mkdir -p "${SNAP_COMMON}/repositories"

if [ "$mode" = "runner" ]; then
    # --- Runner --------------------------------------------------------------
    # URL of the Semaphore server this runner connects to.
    export_opt SEMAPHORE_WEB_ROOT runner.server-url

    # Registration: with --auto-register the runner registers itself using
    # the registration token and persists the issued token in the token
    # file (required when running with --no-config).
    mkdir -p "${SNAP_COMMON}/runner"
    export SEMAPHORE_RUNNER_TOKEN_FILE="${SNAP_COMMON}/runner/token"
    export SEMAPHORE_RUNNER_PRIVATE_KEY_FILE="${SNAP_COMMON}/runner/private_key"
    export_opt SEMAPHORE_RUNNER_REGISTRATION_TOKEN runner.registration-token
    export_opt SEMAPHORE_RUNNER_TOKEN              runner.token

    export_opt SEMAPHORE_RUNNER_NAME               runner.name
    export_opt SEMAPHORE_RUNNER_WEBHOOK            runner.webhook
    export_opt SEMAPHORE_RUNNER_MAX_PARALLEL_TASKS runner.max-parallel-tasks
    export_opt SEMAPHORE_RUNNER_ONE_OFF            runner.one-off
else
    # --- Database ------------------------------------------------------------
    # Semaphore reads a single set of SEMAPHORE_DB_* variables and picks the
    # database backend based on SEMAPHORE_DB_DIALECT.
    dialect="$(snapctl get server.dialect 2>/dev/null || true)"
    [ -z "$dialect" ] && dialect="sqlite"
    export SEMAPHORE_DB_DIALECT="$dialect"

    case "$dialect" in
        mysql)
            export_opt SEMAPHORE_DB_HOST server.mysql.host
            export_opt SEMAPHORE_DB_USER server.mysql.user
            export_opt SEMAPHORE_DB_PASS server.mysql.pass
            export_opt SEMAPHORE_DB      server.mysql.name
            ;;
        postgres)
            export_opt SEMAPHORE_DB_HOST server.postgres.host
            export_opt SEMAPHORE_DB_USER server.postgres.user
            export_opt SEMAPHORE_DB_PASS server.postgres.pass
            export_opt SEMAPHORE_DB      server.postgres.name
            ;;
        bolt)
            # Deprecated backend, kept for completeness.
            export SEMAPHORE_DB_HOST="${SNAP_COMMON}/database.boltdb"
            ;;
        *)
            # sqlite (default). The "host" is the path to the database file.
            export SEMAPHORE_DB_HOST="${SNAP_COMMON}/database.sqlite"
            ;;
    esac

    # --- Server ----------------------------------------------------------------
    export_opt SEMAPHORE_PORT      server.port
    export_opt SEMAPHORE_INTERFACE server.interface
    export_opt SEMAPHORE_WEB_ROOT  server.web-host

    # --- Security ----------------------------------------------------------------
    export_secret SEMAPHORE_COOKIE_HASH               server.cookie-hash
    export_secret SEMAPHORE_COOKIE_ENCRYPTION         server.cookie-encryption
    export_opt    SEMAPHORE_ACCESS_KEY_ENCRYPTION     server.access-key-encryption
    export_secret SEMAPHORE_RUNNER_REGISTRATION_TOKEN server.runner-registration-token

    # --- Tasks ----------------------------------------------------------------
    export_opt SEMAPHORE_MAX_PARALLEL_TASKS server.max-parallel-tasks
    export_opt SEMAPHORE_USE_REMOTE_RUNNER  server.use-remote-runner

    # --- Email ----------------------------------------------------------------
    export_opt SEMAPHORE_EMAIL_ALERT    server.email.alert
    export_opt SEMAPHORE_EMAIL_SENDER   server.email.sender
    export_opt SEMAPHORE_EMAIL_HOST     server.email.host
    export_opt SEMAPHORE_EMAIL_PORT     server.email.port
    export_opt SEMAPHORE_EMAIL_USERNAME server.email.username
    export_opt SEMAPHORE_EMAIL_PASSWORD server.email.password
    export_opt SEMAPHORE_EMAIL_SECURE   server.email.secure

    # --- LDAP -----------------------------------------------------------------
    export_opt SEMAPHORE_LDAP_ENABLE        server.ldap.enable
    export_opt SEMAPHORE_LDAP_BIND_DN       server.ldap.binddn
    export_opt SEMAPHORE_LDAP_BIND_PASSWORD server.ldap.bindpassword
    export_opt SEMAPHORE_LDAP_SERVER        server.ldap.server
    export_opt SEMAPHORE_LDAP_SEARCH_DN     server.ldap.searchdn
    export_opt SEMAPHORE_LDAP_SEARCH_FILTER server.ldap.searchfilter
    export_opt SEMAPHORE_LDAP_NEEDTLS       server.ldap.needtls
    export_opt SEMAPHORE_LDAP_MAPPING_DN    server.ldap.mappings.dn
    export_opt SEMAPHORE_LDAP_MAPPING_MAIL  server.ldap.mappings.mail
    export_opt SEMAPHORE_LDAP_MAPPING_UID   server.ldap.mappings.uid
    export_opt SEMAPHORE_LDAP_MAPPING_CN    server.ldap.mappings.cn

    # --- Alerts ---------------------------------------------------------------
    export_opt SEMAPHORE_TELEGRAM_ALERT server.telegram.alert
    export_opt SEMAPHORE_TELEGRAM_CHAT  server.telegram.chat
    export_opt SEMAPHORE_TELEGRAM_TOKEN server.telegram.token
    export_opt SEMAPHORE_SLACK_ALERT    server.slack.alert
fi

# --- Drop privileges --------------------------------------------------------
# The services must not run as root. Snapd creates the snap_daemon user
# (declared in snapcraft.yaml via system-usernames); everything above that
# needs root (snapctl set) is already done, so switch to snap_daemon before
# exec-ing Semaphore. Non-root invocations (CLI without sudo) skip this.
DAEMON_USER="snap_daemon"

if [ "$(id -u)" = "0" ] && id "$DAEMON_USER" >/dev/null 2>&1; then
    # Semaphore and the tools it spawns (git, ansible) need a writable HOME.
    export HOME="${SNAP_COMMON}/home"
    mkdir -p "$HOME"

    # Hand over data created by earlier root-running versions (one-time:
    # files created after the switch are already owned by snap_daemon).
    if [ "$(stat -c %U "$SNAP_COMMON" 2>/dev/null)" != "$DAEMON_USER" ]; then
        chown -R "$DAEMON_USER:$DAEMON_USER" "$SNAP_COMMON"
    fi

    setpriv="${SNAP}/usr/bin/setpriv"
    [ -x "$setpriv" ] || setpriv="setpriv"
    exec "$setpriv" --clear-groups --reuid "$DAEMON_USER" --regid "$DAEMON_USER" -- "$@"
fi

exec "$@"
