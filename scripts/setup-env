#!/bin/sh
#
# Snap command-chain wrapper for Semaphore.
#
# Reads the snap configuration options (managed via `snap set semaphore ...`)
# and exports them as SEMAPHORE_* environment variables before launching the
# actual command. Semaphore is started with `--no-config`, so its whole
# configuration comes from these variables instead of a config.json file.
#
# This script is referenced from `command-chain` in snapcraft.yaml and must
# end by exec-ing "$@" so the real app command keeps running as the same
# process (important for the systemd-managed daemon).
set -eu

# Export ENV_NAME=<value of snap option SNAP_KEY>, but only when the option is
# set to a non-empty value. Skipping empty values lets Semaphore apply its own
# built-in defaults and avoids feeding empty strings to typed (e.g. integer)
# config fields.
export_opt() {
    _env_name="$1"
    _snap_key="$2"
    _value="$(snapctl get "$_snap_key" 2>/dev/null || true)"
    if [ -n "$_value" ]; then
        export "$_env_name=$_value"
    fi
}

# Export ENV_NAME=<value of snap option SNAP_KEY>, generating and persisting a
# random secret on first use. The value is stored back into the snap options
# so it stays stable across restarts: cookie secrets keep sessions valid and
# access_key_encryption must never change once data is encrypted with it.
export_secret() {
    _env_name="$1"
    _snap_key="$2"
    _value="$(snapctl get "$_snap_key" 2>/dev/null || true)"
    if [ -z "$_value" ]; then
        _value="$(tr -dc A-Za-z0-9 </dev/urandom | head -c 32)"
        # snapctl set needs root; for non-root CLI runs fall back to a
        # one-off value instead of failing (the daemon runs as root and
        # will persist real secrets on its first start).
        snapctl set "$_snap_key=$_value" 2>/dev/null || true
    fi
    export "$_env_name=$_value"
}

# --- Database -------------------------------------------------------------
# Semaphore reads a single set of SEMAPHORE_DB_* variables and picks the
# database backend based on SEMAPHORE_DB_DIALECT.
dialect="$(snapctl get dialect 2>/dev/null || true)"
[ -z "$dialect" ] && dialect="sqlite"
export SEMAPHORE_DB_DIALECT="$dialect"

case "$dialect" in
    mysql)
        export_opt SEMAPHORE_DB_HOST mysql.host
        export_opt SEMAPHORE_DB_USER mysql.user
        export_opt SEMAPHORE_DB_PASS mysql.pass
        export_opt SEMAPHORE_DB      mysql.name
        ;;
    postgres)
        export_opt SEMAPHORE_DB_HOST postgres.host
        export_opt SEMAPHORE_DB_USER postgres.user
        export_opt SEMAPHORE_DB_PASS postgres.pass
        export_opt SEMAPHORE_DB      postgres.name
        ;;
    bolt)
        # Deprecated backend, kept for existing installations.
        export SEMAPHORE_DB_HOST="${SNAP_COMMON}/database.boltdb"
        ;;
    *)
        # sqlite (default). The "host" is the path to the database file.
        export SEMAPHORE_DB_HOST="${SNAP_COMMON}/database.sqlite"
        ;;
esac

# --- Server ---------------------------------------------------------------
export_opt SEMAPHORE_PORT      port
export_opt SEMAPHORE_INTERFACE interface
export_opt SEMAPHORE_WEB_ROOT  web-host
export SEMAPHORE_TMP_PATH="${SNAP_COMMON}/repositories"
export SEMAPHORE_GIT_CLIENT="go_git"
mkdir -p "${SNAP_COMMON}/repositories"

# --- Security -------------------------------------------------------------
export_secret SEMAPHORE_COOKIE_HASH               cookie-hash
export_secret SEMAPHORE_COOKIE_ENCRYPTION         cookie-encryption
export_opt    SEMAPHORE_ACCESS_KEY_ENCRYPTION     access-key-encryption
export_secret SEMAPHORE_RUNNER_REGISTRATION_TOKEN runner-registration-token

# --- Tasks ----------------------------------------------------------------
export_opt SEMAPHORE_MAX_PARALLEL_TASKS max-parallel-tasks
export_opt SEMAPHORE_USE_REMOTE_RUNNER  use-remote-runner

# --- Email ----------------------------------------------------------------
export_opt SEMAPHORE_EMAIL_ALERT    email-alert
export_opt SEMAPHORE_EMAIL_SENDER   email-sender
export_opt SEMAPHORE_EMAIL_HOST     email-host
export_opt SEMAPHORE_EMAIL_PORT     email-port
export_opt SEMAPHORE_EMAIL_USERNAME email-username
export_opt SEMAPHORE_EMAIL_PASSWORD email-password
export_opt SEMAPHORE_EMAIL_SECURE   email-secure

# --- LDAP -----------------------------------------------------------------
export_opt SEMAPHORE_LDAP_ENABLE        ldap-enable
export_opt SEMAPHORE_LDAP_BIND_DN       ldap-binddn
export_opt SEMAPHORE_LDAP_BIND_PASSWORD ldap-bindpassword
export_opt SEMAPHORE_LDAP_SERVER        ldap-server
export_opt SEMAPHORE_LDAP_SEARCH_DN     ldap-searchdn
export_opt SEMAPHORE_LDAP_SEARCH_FILTER ldap-searchfilter
export_opt SEMAPHORE_LDAP_NEEDTLS       ldap-needtls
export_opt SEMAPHORE_LDAP_MAPPING_DN    ldap-mappings.dn
export_opt SEMAPHORE_LDAP_MAPPING_MAIL  ldap-mappings.mail
export_opt SEMAPHORE_LDAP_MAPPING_UID   ldap-mappings.uid
export_opt SEMAPHORE_LDAP_MAPPING_CN    ldap-mappings.cn

# --- Alerts ---------------------------------------------------------------
export_opt SEMAPHORE_TELEGRAM_ALERT telegram-alert
export_opt SEMAPHORE_TELEGRAM_CHAT  telegram-chat
export_opt SEMAPHORE_TELEGRAM_TOKEN telegram-token
export_opt SEMAPHORE_SLACK_ALERT    slack-alert

exec "$@"
